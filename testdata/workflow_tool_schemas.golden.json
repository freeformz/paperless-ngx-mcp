            "remove_document_types": {
              "description": "Document type IDs to remove",
              "items": {
                "minimum": 1,
                "type": "integer"
              },
              "type": "array"
            },
            "remove_owners": {
              "description": "User IDs to remove as owner",
              "items": {
                "minimum": 1,
