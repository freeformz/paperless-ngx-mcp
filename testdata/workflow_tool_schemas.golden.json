        "type": "string"
      },
      "order": {
        "description": "Sort order (default 0)",
        "pattern": "^-?\\d+$",
        "type": [
          "integer",
          "string"
        ]
      },
      "triggers": {
        "description": "Array of trigger objects (at least one): type plus that type's filters",
        "items": {
          "additionalProperties": false,
          "properties": {
            "clear": {
              "description": "Fields to clear",
              "items": {
                "enum": [
                  "filter_path",
                  "filter_filename",
                  "filter_mailrule",
                  "filter_custom_field_query",
                  "filter_has_correspondent",
                  "filter_has_document_type",
                  "filter_has_storage_path",
                  "schedule_date_custom_field",
                  "match"
                ]
              },
              "type": "array"
            },
            "filter_custom_field_query": {
              "description": "Custom field query terms, e.g. [\"field_name\", \"exact\", \"value\"] (custom_field_query syntax)",
              "type": [
                "array",
                "string"
              ]
            },
            "filter_filename": {
              "description": "Filename filter (wildcards such as *.pdf, case-insensitive)",
              "maxLength": 256,
              "type": "string"
            },
            "filter_has_all_tags": {
              "description": "Tag IDs: the document has all",
              "items": {
                "minimum": 1,
                "type": "integer"
              },
              "type": "array"
            },
            "filter_has_any_correspondents": {
              "description": "Correspondent IDs: the document has one",
              "items": {
                "minimum": 1,
                "type": "integer"
              },
              "type": "array"
            },
            "filter_has_any_document_types": {
              "description": "Document type IDs: the document has one",
              "items": {
                "minimum": 1,
                "type": "integer"
              },
              "type": "array"
            },
            "filter_has_any_storage_paths": {
              "description": "Storage path IDs: the document has one",
              "items": {
                "minimum": 1,
                "type": "integer"
              },
              "type": "array"
            },
            "filter_has_correspondent": {
              "description": "Correspondent ID the document must have",
              "minimum": 1,
              "type": "integer"
            },
            "filter_has_document_type": {
              "description": "Document type ID the document must have",
              "minimum": 1,
              "type": "integer"
            },
            "filter_has_not_correspondents": {
              "description": "Correspondent IDs: the document has none",
              "items": {
                "minimum": 1,
                "type": "integer"
              },
              "type": "array"
            },
            "filter_has_not_document_types": {
              "description": "Document type IDs: the document has none",
              "items": {
                "minimum": 1,
                "type": "integer"
              },
              "type": "array"
            },
            "filter_has_not_storage_paths": {
              "description": "Storage path IDs: the document has none",
              "items": {
                "minimum": 1,
                "type": "integer"
              },
              "type": "array"
            },
            "filter_has_not_tags": {
              "description": "Tag IDs: the document has none",
              "items": {
                "minimum": 1,
                "type": "integer"
              },
              "type": "array"
            },
            "filter_has_storage_path": {
              "description": "Storage path ID the document must have",
              "minimum": 1,
              "type": "integer"
            },
            "filter_has_tags": {
              "description": "Tag IDs: the document has any",
              "items": {
                "minimum": 1,
                "type": "integer"
              },
              "type": "array"
            },
            "filter_mailrule": {
              "description": "Mail rule ID (documents fetched by that rule)",
              "minimum": 1,
              "type": "integer"
            },
            "filter_path": {
              "description": "Path filter (wildcards *, case-insensitive)",
              "maxLength": 256,
              "type": "string"
            },
            "is_insensitive": {
              "description": "Case-insensitive matching (default true)",
              "type": "boolean"
            },
            "match": {
              "description": "Content match pattern, used with matching_algorithm",
              "maxLength": 256,
              "type": "string"
            },
            "matching_algorithm": {
              "description": "Matching algorithm: 0 none, 1 any, 2 all, 3 literal, 4 regex, 5 fuzzy",
              "enum": [
                0,
                1,
                2,
                3,
                4,
                5,
                "none",
                "any",
                "all",
                "literal",
                "regex",
                "fuzzy"
              ],
              "type": [
                "integer",
                "string"
              ]
            },
            "schedule_date_custom_field": {
              "description": "Type 4: custom field ID when schedule_date_field is custom_field",
              "minimum": 1,
              "type": "integer"
            },
            "schedule_date_field": {
              "description": "Type 4: the date field to schedule from",
              "enum": [
                "added",
                "created",
                "modified",
                "custom_field"
              ]
            },
            "schedule_is_recurring": {
              "description": "Type 4: repeat the schedule",
              "type": "boolean"
            },
            "schedule_offset_days": {
              "description": "Type 4: days to offset the schedule by",
              "type": "integer"
            },
            "schedule_recurring_interval_days": {
              "description": "Type 4: days between recurring runs",
              "minimum": 1,
              "type": "integer"
            },
            "sources": {
              "description": "Document sources (consumption, added and updated triggers): 1 consume_folder, 2 api_upload, 3 mail_fetch, 4 web_ui. [] means any; a new trigger without sources gets 1, 2 and 3",
              "items": {
                "enum": [
                  1,
                  2,
                  3,
                  4,
                  "consume_folder",
                  "api_upload",
                  "mail_fetch",
                  "web_ui"
                ],
                "type": [
                  "integer",
                  "string"
                ]
              },
              "type": "array"
            },
            "type": {
              "description": "Trigger type: 1 consumption (needs filter_filename, filter_path or filter_mailrule in every call), 2 document_added, 3 document_updated, 4 scheduled, 5 manual (run with workflow_run)",
              "enum": [
                1,
                2,
                3,
                4,
                5,
                "consumption",
                "document_added",
                "document_updated",
                "scheduled",
                "manual"
              ],
              "type": [
                "integer",
                "string"
              ]
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        "minItems": 1,
        "type": [
          "array",
          "string"
        ]
      }
    },
    "required": [
      "actions",
      "name",
      "triggers"
    ],
    "type": "object"
  },
