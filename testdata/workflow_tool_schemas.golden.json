                },
                "body": {
                  "description": "Request body",
                  "type": "string"
                },
                "clear": {
                  "description": "Fields to clear",
                  "items": {
                    "enum": [
                      "params",
                      "body",
                      "headers"
                    ]
                  },
                  "type": "array"
                },
                "headers": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "Request headers",
                  "type": "object"
                },
                "include_document": {
                  "type": "boolean"
                },
                "params": {
                  "additionalProperties": true,
                  "description": "Request parameters",
