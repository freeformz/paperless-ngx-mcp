{
  "workflow_action_update": {
    "properties": {
      "ai_create_missing": {
        "description": "Type 8: create suggested objects that don't exist yet",
        "type": "boolean"
      },
      "ai_overwrite_existing": {
        "description": "Type 8: overwrite values the document already has",
        "type": "boolean"
      },
      "ai_suggestion_fields": {
        "description": "Array of fields to fill from AI suggestions (type 8; non-empty)",
        "items": {
          "enum": [
            "title",
            "tags",
            "correspondent",
            "document_type",
            "storage_path",
            "created"
          ]
        },
        "type": [
          "array",
          "string"
        ]
      },
      "assign_change_groups": {
        "description": "Array of group IDs to grant change permission",
        "items": {
          "minimum": 1,
          "type": "integer"
        },
        "type": [
          "array",
          "string"
        ]
      },
      "assign_change_users": {
        "description": "Array of user IDs to grant change permission",
        "items": {
          "minimum": 1,
          "type": "integer"
        },
        "type": [
          "array",
          "string"
        ]
      },
      "assign_correspondent": {
        "description": "Correspondent ID to assign",
        "minimum": 1,
        "pattern": "^-?\\d+$",
        "type": [
          "integer",
          "string"
        ]
      },
      "assign_custom_fields": {
        "description": "Array of custom field IDs to assign",
        "items": {
          "minimum": 1,
          "type": "integer"
        },
        "type": [
          "array",
          "string"
        ]
      },
      "assign_custom_fields_values": {
        "additionalProperties": false,
        "description": "Object with custom field values to assign, keyed by custom field ID",
        "patternProperties": {
          "^[0-9]+$": true
        },
        "type": [
          "object",
          "string"
        ]
      },
      "assign_document_type": {
        "description": "Document type ID to assign",
        "minimum": 1,
        "pattern": "^-?\\d+$",
        "type": [
          "integer",
          "string"
        ]
      },
      "assign_owner": {
        "description": "Owner user ID to assign",
        "minimum": 1,
        "pattern": "^-?\\d+$",
        "type": [
          "integer",
          "string"
        ]
      },
      "assign_storage_path": {
        "description": "Storage path ID to assign",
        "minimum": 1,
        "pattern": "^-?\\d+$",
        "type": [
          "integer",
          "string"
        ]
      },
      "assign_tags": {
        "description": "Array of tag IDs to assign",
        "items": {
          "minimum": 1,
          "type": "integer"
        },
        "type": [
          "array",
          "string"
        ]
      },
      "assign_title": {
        "description": "Title to assign: a Jinja2 template, may use custom fields (e.g. {{ custom_fields['Name'].value }})",
        "type": "string"
      },
      "assign_view_groups": {
        "description": "Array of group IDs to grant view permission",
        "items": {
          "minimum": 1,
          "type": "integer"
        },
        "type": [
          "array",
          "string"
        ]
      },
      "assign_view_users": {
        "description": "Array of user IDs to grant view permission",
        "items": {
          "minimum": 1,
          "type": "integer"
        },
        "type": [
          "array",
          "string"
        ]
      },
      "clear": {
        "description": "Array of fields to clear",
        "items": {
          "enum": [
            "assign_title",
            "assign_correspondent",
            "assign_document_type",
            "assign_storage_path",
            "assign_owner",
            "assign_custom_fields_values"
          ]
        },
        "type": [
          "array",
          "string"
        ]
      },
      "id": {
        "description": "Action ID",
        "pattern": "^-?\\d+$",
        "type": [
          "integer",
          "string"
        ]
      },
      "passwords": {
        "description": "Array of passwords to try (type 5; non-empty)",
        "items": {
          "pattern": "\\S",
          "type": "string"
        },
        "type": [
          "array",
          "string"
        ]
      },
      "remove_all_correspondents": {
        "description": "Remove the correspondent",
        "type": "boolean"
      },
      "remove_all_custom_fields": {
        "type": "boolean"
      },
      "remove_all_document_types": {
        "description": "Remove the document type",
        "type": "boolean"
      },
      "remove_all_owners": {
        "description": "Remove the owner",
        "type": "boolean"
      },
      "remove_all_permissions": {
        "type": "boolean"
      },
      "remove_all_storage_paths": {
        "description": "Remove the storage path",
        "type": "boolean"
      },
      "remove_all_tags": {
        "type": "boolean"
      },
      "remove_change_groups": {
        "description": "Array of group IDs to remove change permission from",
        "items": {
          "minimum": 1,
          "type": "integer"
        },
        "type": [
          "array",
          "string"
        ]
      },
      "remove_change_users": {
        "description": "Array of user IDs to remove change permission from",
        "items": {
          "minimum": 1,
          "type": "integer"
        },
        "type": [
          "array",
          "string"
        ]
      },
      "remove_correspondents": {
        "description": "Array of correspondent IDs to remove",
        "items": {
          "minimum": 1,
          "type": "integer"
        },
        "type": [
          "array",
          "string"
        ]
      },
      "remove_custom_fields": {
        "description": "Array of custom field IDs to remove",
        "items": {
          "minimum": 1,
          "type": "integer"
        },
        "type": [
          "array",
          "string"
        ]
      },
      "remove_document_types": {
        "description": "Array of document type IDs to remove",
        "items": {
          "minimum": 1,
          "type": "integer"
        },
        "type": [
          "array",
          "string"
        ]
      },
      "remove_owners": {
        "description": "Array of user IDs to remove as owner",
        "items": {
          "minimum": 1,
          "type": "integer"
        },
        "type": [
          "array",
          "string"
        ]
      },
      "remove_storage_paths": {
        "description": "Array of storage path IDs to remove",
        "items": {
          "minimum": 1,
          "type": "integer"
        },
        "type": [
          "array",
          "string"
        ]
      },
      "remove_tags": {
        "description": "Array of tag IDs to remove",
        "items": {
          "minimum": 1,
          "type": "integer"
        },
        "type": [
          "array",
          "string"
        ]
      },
      "remove_view_groups": {
        "description": "Array of group IDs to remove view permission from",
        "items": {
          "minimum": 1,
          "type": "integer"
        },
        "type": [
          "array",
          "string"
        ]
      },
      "remove_view_users": {
        "description": "Array of user IDs to remove view permission from",
        "items": {
          "minimum": 1,
          "type": "integer"
        },
        "type": [
          "array",
          "string"
        ]
      },
      "type": {
        "description": "Action type: 1 assignment, 2 removal, 5 password_removal (needs passwords), 6 move_to_trash. Types 3, 4, 7 and 8 can only be set through workflow_update",
        "enum": [
          1,
          2,
          5,
          6,
          "assignment",
          "removal",
          "password_removal",
          "move_to_trash"
        ],
        "type": [
          "integer",
          "string"
        ]
      }
    },
    "required": [
      "id"
    ],
    "type": "object"
  },
